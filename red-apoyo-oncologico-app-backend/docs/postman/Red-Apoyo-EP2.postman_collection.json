    {
      "name": "01 Salud y BD",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test('Base conectada',()=>pm.expect(pm.response.json().data.database).to.eql('connected'));"
            ]
          }
        }
      ],
      "response": []
    },
